      "position": [672, 0],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "8KdACTgMQpgNttey", "mode": "id" },
        "mode": "once",
        "workflowInputs": { "mappingMode": "defineBelow", "value": { "brand_name": "={{ $('Add Brand Form').first().json.brand_name }}" } },
        "options": { "waitForSubWorkflow": false }
      }
    }
  ]
