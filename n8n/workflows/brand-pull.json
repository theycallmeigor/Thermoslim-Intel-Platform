    { "parameters": { "jsCode": "const pageResp = $input.first().json;\nconst state = $('Init Page').first().json;\nconst meta = pageResp.meta || {};\nconst currentPage = meta.current_page || meta.page || state.page;\nconst totalPages = meta.last_page || meta.total_pages || meta.total || state.total_pages;\nconst data = Array.isArray(pageResp.data) ? pageResp.data : [];\nconst known = new Set((state.known_ids || []).map(String));\nconst adsToUpsert = [];\nlet hitKnown = false;\nfor (const ad of data) {\n  const ext = String(ad.external_id ?? '');\n  if (ext && known.has(ext)) { hitKnown = true; continue; }\n  adsToUpsert.push({\n    json: {\n      id: ad.id, external_id: ad.external_id ?? null,\n      brand_id: state.brand_id, brand_name: state.brand_name,\n      brand_external_id: ad.brand ? ad.brand.external_id : null,\n      platform: ad.platform ?? null, display_format: ad.display_format ?? null,\n      title: ad.title ?? null, body: ad.body ?? null,\n      cta_type: ad.cta_type ?? null, cta_text: ad.cta_text ?? null,\n      landing_page: ad.landing_page ?? null, link_description: ad.link_description ?? null,\n      start_date: ad.start_date ?? null, end_date: ad.end_date ?? null,\n      days_active: ad.days_active ?? null, active_in_library: ad.active_in_library ?? null,\n      performance_score: ad.performance_score ?? null,\n      performance_score_title: ad.performance_score_title ?? null,\n      ad_spend_range_score: ad.ad_spend_range_score ?? null,\n      ad_spend_range_score_title: ad.ad_spend_range_score_title ?? null,\n      gender_audience: ad.gender_audience ?? null,\n      age_audience_min: ad.age_audience_min ?? null, age_audience_max: ad.age_audience_max ?? null,\n      media_type: ad.media && ad.media[0] ? ad.media[0].type : null,\n      media_url: ad.media && ad.media[0] ? ad.media[0].url : null,\n      thumbnail_url: ad.media && ad.media[0] ? ad.media[0].thumbnail_url : null,\n      share_url: ad.share_url ?? null,\n      updated_at: new Date().toISOString(),\n      _page: currentPage, _total_pages: totalPages,\n      _brand_id: state.brand_id, _gethookd_brand_id: state.gethookd_brand_id,\n      _brand_name: state.brand_name, _status_filter: state.status_filter\n    }\n  });\n}\nconst allKnown = hitKnown && adsToUpsert.length === 0;\nif (adsToUpsert.length === 0) {\n  return [{ json: { _empty: true, _stop: allKnown, _page: currentPage, _total_pages: totalPages, _brand_id: state.brand_id, _gethookd_brand_id: state.gethookd_brand_id, _brand_name: state.brand_name, _status_filter: state.status_filter }}];\n}\nadsToUpsert[adsToUpsert.length - 1].json._stop = allKnown;\nadsToUpsert[adsToUpsert.length - 1].json._empty = false;\nreturn adsToUpsert;" }, "id": "b1aadb24-16d7-4872-90b5-1d0dfa73c4cf", "name": "Extract Ads", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1344, 128] },
