    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of items) {\n  const ad = item.json;\n  const meta = $('GetHookd — Fetch Page1').first().json.meta || {};\n  const currentPage = meta.current_page || meta.page || 1;\n  const setPageData = $('Set Page1').first().json;\n  const brand = setPageData.brand;\n\n  results.push({\n    json: {\n      id: ad.id,\n      external_id: ad.external_id ?? null,\n      brand_name: brand,\n      brand_external_id: ad.brand ? ad.brand.external_id : null,\n      platform: ad.platform ?? null,\n      display_format: ad.display_format ?? null,\n      title: ad.title ?? null,\n      body: ad.body ?? null,\n      cta_type: ad.cta_type ?? null,\n      cta_text: ad.cta_text ?? null,\n      landing_page: ad.landing_page ?? null,\n      link_description: ad.link_description ?? null,\n      start_date: ad.start_date ?? null,\n      end_date: ad.end_date ?? null,\n      days_active: ad.days_active ?? null,\n      active_in_library: ad.active_in_library ?? null,\n      performance_score: ad.performance_score ?? null,\n      performance_score_title: ad.performance_score_title ?? null,\n      ad_spend_range_score: ad.ad_spend_range_score ?? null,\n      ad_spend_range_score_title: ad.ad_spend_range_score_title ?? null,\n      gender_audience: ad.gender_audience ?? null,\n      age_audience_min: ad.age_audience_min ?? null,\n      age_audience_max: ad.age_audience_max ?? null,\n      media_type: ad.media && ad.media[0] ? ad.media[0].type : null,\n      media_url: ad.media && ad.media[0] ? ad.media[0].url : null,\n      thumbnail_url: ad.media && ad.media[0] ? ad.media[0].thumbnail_url : null,\n      share_url: ad.share_url ?? null,\n      updated_at: new Date().toISOString(),\n      _page: currentPage,\n      _total_pages: setPageData.total_pages\n    }\n  });\n}\n\nreturn results;"
      },
