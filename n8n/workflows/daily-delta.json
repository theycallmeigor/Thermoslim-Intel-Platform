    { "id": "2251e538-8c17-4a2e-8308-efd8217ace65", "name": "Filter New vs Known", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1344, 128], "parameters": { "jsCode": "const state = $('Init Delta State').first().json;\nconst pageResp = $input.first().json;\nconst meta = pageResp.meta || {};\nconst currentPage = meta.current_page || meta.page || state.page;\nconst totalPages = meta.last_page || meta.total_pages || state.total_pages;\nconst data = Array.isArray(pageResp.data) ? pageResp.data : [];\nconst known = new Set((state.known_external_ids || []).map(String));\nconst newAds = [];\nlet hitKnown = false;\nfor (const ad of data) {\n  const ext = String(ad.external_id ?? '');\n  if (ext && known.has(ext)) { hitKnown = true; continue; }\n  newAds.push({ json: {\n    id: ad.id, external_id: ad.external_id ?? null,\n    brand_id: state.brand_id, brand_name: state.brand,\n    brand_external_id: ad.brand ? ad.brand.external_id : null,\n    platform: ad.platform ?? null, display_format: ad.display_format ?? null,\n    title: ad.title ?? null, body: ad.body ?? null,\n    cta_type: ad.cta_type ?? null, cta_text: ad.cta_text ?? null,\n    landing_page: ad.landing_page ?? null, start_date: ad.start_date ?? null,\n    end_date: ad.end_date ?? null, days_active: ad.days_active ?? null,\n    performance_score: ad.performance_score ?? null,\n    gender_audience: ad.gender_audience ?? null,\n    age_audience_min: ad.age_audience_min ?? null, age_audience_max: ad.age_audience_max ?? null,\n    media_type: ad.media && ad.media[0] ? ad.media[0].type : null,\n    media_url: ad.media && ad.media[0] ? ad.media[0].url : null,\n    thumbnail_url: ad.media && ad.media[0] ? ad.media[0].thumbnail_url : null,\n    share_url: ad.share_url ?? null,\n    updated_at: new Date().toISOString(),\n    _page: currentPage, _total_pages: totalPages,\n    _brand_id: state.brand_id, _brand: state.brand,\n    _hit_known: hitKnown\n  }});\n}\nconst allKnown = hitKnown && newAds.length === 0;\nif (newAds.length === 0) {\n  return [{ json: { _empty: true, _stop: allKnown, _page: currentPage, _total_pages: totalPages, _brand_id: state.brand_id, _brand: state.brand } }];\n}\nnewAds[newAds.length-1].json._stop = allKnown;\nreturn newAds;" } },
    { "id": "45aecabe-07a3-4bc8-9890-b68ff975302e", "name": "Upsert New Ads", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1568, 128], "parameters": { "method": "POST", "url": "https://fliqklclucdhjemdjatr.supabase.co/rest/v1/ads", "authentication": "predefinedCredentialType", "nodeCredentialType": "supabaseApi", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Prefer", "value": "resolution=merge-duplicates,return=minimal" }, { "name": "Content-Type", "value": "application/json" }] }, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ ($json._empty || $json._stop) ? \"[]\" : JSON.stringify((({ _page, _total_pages, _brand_id, _brand, _stop, _empty, _hit_known, ...rest }) => rest)($json)) }}", "options": {} } },
