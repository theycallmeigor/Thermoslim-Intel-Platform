    { "id": "d3153c8c-de5b-4f18-aee4-4ffe8b31d705", "name": "Init Delta State", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [896, 192], "parameters": { "jsCode": "const brand = $('Per Brand').item.json;\nconst knownRows = items.map(i => i.json.external_id).filter(Boolean);\nreturn [{ json: {\n  brand_id: brand.id,\n  brand: brand.name,\n  gethookd_brand_id: brand.gethookd_brand_id,\n  known_external_ids: knownRows,\n  page: 1,\n  total_pages: 500,\n  status_filter: 'active',\n  _stop: false\n}}];" } },
